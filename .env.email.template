# Email Management Agent Configuration Template
# Copy this to .env and configure your specific values

# ===== Braintrust Configuration =====
BRAINTRUST_API_KEY=your_braintrust_api_key_here
PROJECT_NAME=EmailManagementEvals
EVAL_PROJECT_NAME=EmailManagementEvals

# ===== Model Configuration =====
OPENAI_API_KEY=your_openai_api_key_here
FRONTIER_MODEL=gpt-4o-mini

# Local model routing (Ollama OpenAI-compatible)
USE_LOCAL_MODEL=false
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_MODEL=llama3.3:70b

# ===== Email Evaluation Configuration =====
# Evaluation mode: dual, code_only, llm_only
EMAIL_EVAL_MODE=dual

# Evaluation focus: all, zero_inbox, search, errors
EMAIL_EVAL_FOCUS=all

# Use mock email services (recommended for testing)
USE_MOCK_EMAIL_SERVICES=true

# ===== Braintrust OTLP Configuration =====
BRAINTRUST_PARENT=project_name:${PROJECT_NAME}

# ===== Azure Monitor Configuration (Optional) =====
# Uncomment and configure if you want to send telemetry to Azure
# AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=your-key-here

# ===== OpenTelemetry Configuration =====
# Optional: Configure custom OTEL exporter
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.braintrust.dev/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer ${BRAINTRUST_API_KEY},x-bt-parent=project_name:${PROJECT_NAME}

# ===== Testing Configuration =====
# Maximum concurrency for evaluations (recommended: 1-3)
EVAL_MAX_CONCURRENCY=2

# Enable verbose logging for debugging
EVAL_VERBOSE_LOGGING=false

# Timeout for individual operations (seconds)
EVAL_OPERATION_TIMEOUT=30